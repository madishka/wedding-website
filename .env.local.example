# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The SERVICE ROLE key, not the anon/publishable one. It bypasses row
# level security, so it is server-only and must never reach the browser
# or be committed. (Rotate it in the dashboard if it ever leaks.)
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the guest links written to scripts/out/links.csv.
SITE_URL=http://localhost:3000

# OPTIONAL. Signs the cookie that remembers a household has typed their
# password. Leave it unset and one is derived from the service role key
# above — which is why there is nothing extra to configure in Vercel.
#
# Set it only if you'd rather have a dedicated secret:
#   openssl rand -base64 32
#
# Changing or rotating either key logs every guest out of the password
# screen once. Nothing else breaks.
# UNLOCK_SECRET=
